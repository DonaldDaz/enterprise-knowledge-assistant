# Copy to .env. These local defaults are public; replace them before any external deployment.
POSTGRES_PASSWORD=local-postgres-change-me
MINIO_ROOT_USER=local-minio
MINIO_ROOT_PASSWORD=local-minio-change-me
JWT_SECRET=local-jwt-change-me-please
ADMIN_PASSWORD=admin-local
HR_PASSWORD=hr-local
FINANCE_PASSWORD=finance-local
EMPLOYEE_PASSWORD=employee-local
MAX_REQUESTS_PER_MINUTE=20
MAX_REQUEST_COST_USD=0.02
MAX_DAILY_COST_USD=1.00
# Set to 0 for the local deterministic provider, or model-specific prices later.
ESTIMATED_USD_PER_1K_TOKENS=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
